# Copy to .dev.vars for local development (wrangler reads .dev.vars, not .env).
# In production, set each of these as a Cloudflare Pages secret:
#   npx wrangler pages secret put NAME --project-name striatix
#
# DATABASE_URL is not used: the database is Cloudflare D1, bound as `DB` in wrangler.toml.

# Random string, at least 32 chars. Used to hash IPs (sha256(ip + pepper)) and to sign
# unsubscribe links. Generate with: openssl rand -hex 32
IP_HASH_PEPPER=

# Resend API key (https://resend.com/api-keys). Free tier: 3,000 emails/month, 100/day.
EMAIL_PROVIDER_API_KEY=

# The From address must be on a domain verified in Resend. A @gmail.com address cannot be
# used as From with any transactional provider. Decided: an address on striatix.com.
# Leave empty until striatix.com is verified in Resend; signups are still stored meanwhile.
EMAIL_FROM=waitlist@striatix.com
EMAIL_FROM_NAME=Striatix Supplements
EMAIL_REPLY_TO=striatixsupps@gmail.com
NOTIFY_TO=striatixsupps@gmail.com

# Bearer token for GET /admin/waitlist.csv. Generate with: openssl rand -hex 32
ADMIN_EXPORT_TOKEN=

# Exact origin allowed to call the API (no trailing slash). Localhost is allowed only
# when ENVIRONMENT=development.
ALLOWED_ORIGIN=https://striatix.com
ENVIRONMENT=production

# Public base URL used to build unsubscribe links in emails.
PUBLIC_BASE_URL=https://striatix.com

# IANA timezone for the notification email timestamps.
NOTIFY_TIMEZONE=UTC
